# Copiate in .env:  cp .env.example .env
#
# Solo segreti: tutto il resto sta nei file in config/.
# Docker: compose legge .env da solo.
# pip: caricatelo nella shell prima di lanciare cicerone:
#   set -a; source .env; set +a

# Cambiateli: chi li conosce può leggere i suggerimenti o lanciare un retrain.
SERVE_AUTH_TOKEN=cambiami-serve
TRIGGER_AUTH_TOKEN=cambiami-trigger

# --- Solo con l'online training (vedi config/cicerone.serve.toml) ---------
# Almeno 16 caratteri. Con Docker aggiungetela anche in docker-compose.yml.
# ARTIFACT_HMAC_KEY=cambiami-chiave-lunga-almeno-16

# --- Solo se passate a S3 (vedi config/cicerone.toml) ----------------------
# Con Docker aggiungete queste variabili anche in docker-compose.yml.
# INPUT_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# INPUT_S3_ACCESS_KEY_ID=
# INPUT_S3_SECRET_ACCESS_KEY=
# INPUT_S3_BUCKET=
# OUTPUT_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# OUTPUT_S3_ACCESS_KEY_ID=
# OUTPUT_S3_SECRET_ACCESS_KEY=
# OUTPUT_S3_BUCKET=
